{
    "name": "school/php-crud-unit-test",
    "description": "Sample CRUD project for learning unit testing with PHPUnit",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public public/index.php"
        ]
    }
}
